@model VanPhongPhamOnline.Data.Loai

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Xóa danh mục</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <style>
        body { background: linear-gradient(120deg, #ffebee, #ffcdd2); font-family: 'Segoe UI', sans-serif; padding: 40px; }
        .container-box { background: white; padding: 40px; border-radius: 20px; box-shadow: 0 8px 30px rgba(0,0,0,0.1); max-width: 600px; margin: 0 auto; }
        h1 { color: #d32f2f; font-weight: bold; margin-bottom: 30px; text-align: center; }
        .warning-message { background: linear-gradient(45deg, #ffebee, #ffcdd2); border: 2px solid #d32f2f; border-radius: 15px; padding: 20px; margin-bottom: 30px; text-align: center; color: #d32f2f; font-weight: bold; }
        .detail-row { display: flex; margin-bottom: 15px; padding: 12px 0; border-bottom: 1px solid #e0e0e0; }
        .detail-label { font-weight: 600; color: #333; width: 150px; flex-shrink: 0; }
        .detail-value { color: #666; flex: 1; }
        .btn-delete { background: linear-gradient(45deg, #ef5350, #d32f2f); border: none; color: white; padding: 12px 30px; border-radius: 25px; font-weight: bold; margin-right: 15px; }
        .btn-delete:hover { transform: translateY(-2px); color: white; }
        .btn-cancel { background: linear-gradient(45deg, #78909c, #546e7a); border: none; color: white; padding: 12px 30px; border-radius: 25px; font-weight: bold; text-decoration: none; }
        .btn-cancel:hover { transform: translateY(-2px); color: white; }
        .actions { text-align: center; margin-top: 30px; }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
</head>
<body>
    <div class="container">
        <div class="container-box">
            <h1>⚠️ Xác nhận xóa danh mục</h1>

            @await Html.PartialAsync("_ToastNotification")

            <div class="warning-message">
                Bạn có chắc chắn muốn xóa danh mục này không?<br>
                <strong>Hành động này không thể hoàn tác!</strong>
            </div>

            <div class="detail-row">
                <div class="detail-label">Mã danh mục:</div>
                <div class="detail-value">@Html.DisplayFor(model => model.MaLoai)</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Tên danh mục:</div>
                <div class="detail-value">@Html.DisplayFor(model => model.TenLoai)</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Số sản phẩm:</div>
                <div class="detail-value">@Model.HangHoas.Count()</div>
            </div>

            <div class="actions">
                <form asp-action="Delete" asp-controller="Loai" method="post" style="display:inline;">
                    <input type="hidden" asp-for="MaLoai" />
                    <button type="submit" class="btn-delete" onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">
                        🗑️ Xóa danh mục
                    </button>
                </form>
                <a href="@Url.Action("Index", "Loai")" class="btn-cancel">❌ Hủy bỏ</a>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>