@model VanPhongPhamOnline.Data.Loai

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Chi tiết danh mục</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <style>
        body { background: linear-gradient(120deg, #e3f2fd, #bbdefb); font-family: 'Segoe UI', sans-serif; padding: 40px; }
        .container-box { background: white; padding: 40px; border-radius: 20px; box-shadow: 0 8px 30px rgba(0,0,0,0.1); max-width: 600px; margin: 0 auto; }
        h1 { color: #1976d2; font-weight: bold; margin-bottom: 30px; text-align: center; }
        .detail-row { display: flex; margin-bottom: 15px; padding: 12px 0; border-bottom: 1px solid #e0e0e0; }
        .detail-label { font-weight: 600; color: #333; width: 150px; flex-shrink: 0; }
        .detail-value { color: #666; flex: 1; }
        .back-link, .edit-link { color: #1976d2; text-decoration: none; font-weight: bold; margin-right: 20px; display: inline-block; padding: 10px 20px; border: 2px solid #1976d2; border-radius: 25px; }
        .back-link:hover, .edit-link:hover { background-color: #1976d2; color: white; }
        .actions { text-align: center; margin-top: 30px; }
        .badge { padding: 6px 12px; border-radius: 12px; }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
</head>
<body>
    <div class="container">
        <div class="container-box">
            <h1>Chi tiết danh mục</h1>

            @await Html.PartialAsync("_ToastNotification")

            <div class="detail-row">
                <div class="detail-label">Mã danh mục:</div>
                <div class="detail-value">@Html.DisplayFor(model => model.MaLoai)</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Tên danh mục:</div>
                <div class="detail-value">@Html.DisplayFor(model => model.TenLoai)</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Tên Alias:</div>
                <div class="detail-value">@Html.DisplayFor(model => model.TenLoaiAlias)</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Mô tả:</div>
                <div class="detail-value">@Html.DisplayFor(model => model.MoTa)</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Số sản phẩm:</div>
                <div class="detail-value">@Model.HangHoas.Count()</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Hinh))
            {
                <div class="detail-row">
                    <div class="detail-label">Ảnh:</div>
                    <div class="detail-value">
                        <img src="~/Hinh/Loai/@Model.Hinh" alt="@Model.TenLoai" style="max-width:150px; max-height:150px; border-radius:8px;" />
                    </div>
                </div>
            }

            <div class="actions">
                <a href="@Url.Action("Index", "Loai")" class="back-link">← Quay lại danh sách</a>
                <a href="@Url.Action("Edit", "Loai", new { id = Model.MaLoai })" class="edit-link">✏️ Chỉnh sửa</a>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>