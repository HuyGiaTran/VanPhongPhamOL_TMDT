@model IEnumerable<VanPhongPhamOnline.Data.Loai>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Quản lý danh mục</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style>
        body { background: linear-gradient(120deg, #e3f2fd, #bbdefb); font-family: 'Segoe UI', sans-serif; padding: 40px; }
        .container-box { background: white; padding: 40px; border-radius: 20px; box-shadow: 0 8px 30px rgba(0,0,0,0.1); }
        h1 { color: #1976d2; font-weight: bold; margin-bottom: 30px; text-align: center; }
        .btn-create { background: linear-gradient(45deg, #42a5f5, #1976d2); border: none; color: white; padding: 12px 30px; border-radius: 25px; font-weight: bold; text-decoration: none; display: inline-block; margin-bottom: 20px; }
        .btn-create:hover { transform: translateY(-2px); color: white; text-decoration: none; }
        .table { border-radius: 15px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .table thead th { background: linear-gradient(45deg, #1976d2, #42a5f5); color: white; border: none; padding: 15px; font-weight: 600; }
        .table tbody td { padding: 15px; vertical-align: middle; border-bottom: 1px solid #e0e0e0; }
        .table tbody tr:hover { background-color: #f5f5f5; }
        .btn-action { margin: 0 2px; border-radius: 20px; padding: 6px 12px; font-size: 11px; font-weight: bold; text-decoration: none; display: inline-block; min-width: 60px; text-align: center; }
        .btn-info { background: linear-gradient(45deg, #29b6f6, #0288d1); border: none; color: white; }
        .btn-warning { background: linear-gradient(45deg, #ffb74d, #ff9800); border: none; color: white; }
        .btn-danger { background: linear-gradient(45deg, #ef5350, #d32f2f); border: none; color: white; }
        .back-link { color: #1976d2; text-decoration: none; font-weight: bold; margin-bottom: 20px; display: inline-block; }
    </style>
</head>
<body>
    <div class="container">
        <div class="container-box">
            <a href="@Url.Action("IndexAdmin", "Admin")" class="back-link">← Quay lại trang quản trị</a>

            <h1>Quản lý danh mục</h1>

            @await Html.PartialAsync("_ToastNotification")

            <form asp-action="Search" asp-controller="Loai" method="get" class="mb-3">
                <div class="input-group" style="max-width:420px;">
                    <input type="text" class="form-control" placeholder="Tên danh mục cần tìm..." name="query" value="@(ViewBag.Query ?? string.Empty)" />
                    <div class="input-group-append">
                        <button class="btn btn-outline-primary" type="submit"><i class="fa fa-search"></i> Tìm</button>
                    </div>
                </div>
            </form>

            <a href="@Url.Action("Create", "Loai")" class="btn-create">+ Thêm danh mục mới</a>

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Mã Loại</th>
                            <th>Tên danh mục</th>
                            <th>Tên Alias</th>
                            <th>Mô tả</th>
                            <th>Số sản phẩm</th>
                            <th style="width: 220px; text-align: center;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.MaLoai)</td>
                                <td>@Html.DisplayFor(modelItem => item.TenLoai)</td>
                                <td>@Html.DisplayFor(modelItem => item.TenLoaiAlias)</td>
                                <td>@Html.DisplayFor(modelItem => item.MoTa)</td>
                                <td>@item.HangHoas.Count()</td>
                                <td style="text-align: center; white-space: nowrap;">
                                    <a href="@Url.Action("Details", "Loai", new { id = item.MaLoai })" class="btn-action btn-info">Chi tiết</a>
                                    <a href="@Url.Action("Edit", "Loai", new { id = item.MaLoai })" class="btn-action btn-warning">Sửa</a>
                                    <a href="@Url.Action("Delete", "Loai", new { id = item.MaLoai })" class="btn-action btn-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>