@model VanPhongPhamOnline.Data.Loai

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Chỉnh sửa danh mục</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <style>
        body { background: linear-gradient(120deg, #e3f2fd, #bbdefb); font-family: 'Segoe UI', sans-serif; padding: 40px; }
        .container-box { background: white; padding: 40px; border-radius: 20px; box-shadow: 0 8px 30px rgba(0,0,0,0.1); max-width: 600px; margin: 0 auto; }
        h1 { color: #1976d2; font-weight: bold; margin-bottom: 30px; text-align: center; }
        .form-group label { font-weight: 600; color: #333; margin-bottom: 8px; }
        .form-control { border: 2px solid #e0e0e0; border-radius: 10px; padding: 12px 15px; }
        .btn-submit { background: linear-gradient(45deg, #ff9800, #f57c00); border: none; color: white; padding: 12px 30px; border-radius: 25px; font-weight: bold; width: 100%; margin-top: 20px; }
        .btn-submit:hover { transform: translateY(-2px); color: white; }
        .back-link { color: #1976d2; text-decoration: none; font-weight: bold; margin-bottom: 20px; display: inline-block; }
        .text-danger { font-size: 14px; margin-top: 5px; }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
</head>
<body>
    <div class="container">
        <div class="container-box">
            <a href="@Url.Action("Index", "Loai")" class="back-link">← Quay lại danh sách</a>

            <h1>Chỉnh sửa danh mục</h1>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    Vui lòng kiểm tra lại thông tin. Một số trường bắt buộc chưa được nhập đúng.
                </div>
            }

            <form asp-action="Edit" asp-controller="Loai" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="MaLoai" />

                <div class="form-group">
                    <label asp-for="TenLoai">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="TenLoai" class="form-control" required />
                    <span asp-validation-for="TenLoai" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TenLoaiAlias">Tên Alias</label>
                    <input asp-for="TenLoaiAlias" class="form-control" />
                    <span asp-validation-for="TenLoaiAlias" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MoTa">Mô tả</label>
                    <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="HinhUpload">Ảnh danh mục (tùy chọn)</label>
                    <input type="file" id="HinhUpload" name="HinhUpload" accept="image/*" class="form-control-file" />
                    @if (!string.IsNullOrEmpty(Model.Hinh))
                    {
                        <div class="mt-2">
                            <img src="~/Hinh/Loai/@Model.Hinh" alt="Ảnh hiện tại" style="max-width:150px; max-height:150px; border-radius:8px;" />
                        </div>
                    }
                </div>

                <div class="text-center">
                    <button type="submit" class="btn-submit">Cập nhật danh mục</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>