@model VanPhongPhamOnline.Data.Voucher

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Chi tiết voucher</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <style>
        body { background: linear-gradient(120deg, #e3f2fd, #bbdefb); font-family: 'Segoe UI', sans-serif; padding: 40px; }
        .container-box { background: white; padding: 40px; border-radius: 20px; box-shadow: 0 8px 30px rgba(0,0,0,0.1); max-width: 600px; margin: 0 auto; }
        h1 { color: #1976d2; font-weight: bold; margin-bottom: 30px; text-align: center; }
        .detail-row { display: flex; margin-bottom: 15px; padding: 12px 0; border-bottom: 1px solid #e0e0e0; }
        .detail-label { font-weight: 600; color: #333; width: 150px; flex-shrink: 0; }
        .detail-value { color: #666; flex: 1; }
        .back-link, .edit-link { color: #1976d2; text-decoration: none; font-weight: bold; margin-right: 20px; display: inline-block; padding: 10px 20px; border: 2px solid #1976d2; border-radius: 25px; }
        .back-link:hover, .edit-link:hover { background-color: #1976d2; color: white; }
        .actions { text-align: center; margin-top: 30px; }
        .badge { padding: 6px 12px; border-radius: 12px; font-size: 12px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="container-box">
            <h1>Chi tiết voucher</h1>

            @await Html.PartialAsync("_ToastNotification")

            <div class="detail-row">
                <div class="detail-label">Mã Voucher:</div>
                <div class="detail-value">@Html.DisplayFor(model => model.MaVoucher)</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Tên Voucher:</div>
                <div class="detail-value">@Html.DisplayFor(model => model.TenVoucher)</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Mã giảm giá:</div>
                <div class="detail-value">@Html.DisplayFor(model => model.MaGiamGia)</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Loại giảm giá:</div>
                <div class="detail-value">@(Model.LoaiGiamGia == 0 ? "Phần trăm (%)" : "Tiền mặt (VNĐ)")</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Giá trị giảm:</div>
                <div class="detail-value">@Model.GiaTriGiam.ToString("N0")</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Ngày bắt đầu:</div>
                <div class="detail-value">@Model.NgayBatDau.ToString("dd/MM/yyyy")</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Ngày kết thúc:</div>
                <div class="detail-value">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Số lượng:</div>
                <div class="detail-value">@Model.SoLuong</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Điều kiện tối thiểu:</div>
                <div class="detail-value">@Model.DieuKienToiThieu.ToString("N0") VNĐ</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Trạng thái:</div>
                <div class="detail-value"><span class="@(Model.TrangThai ? "badge bg-success" : "badge bg-danger")">@(Model.TrangThai ? "Hoạt động" : "Khóa")</span></div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Ngày tạo:</div>
                <div class="detail-value">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            <div class="actions">
                <a href="@Url.Action("Index", "Voucher")" class="back-link">← Quay lại danh sách</a>
                <a href="@Url.Action("Edit", "Voucher", new { id = Model.MaVoucher })" class="edit-link">✏️ Chỉnh sửa</a>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>