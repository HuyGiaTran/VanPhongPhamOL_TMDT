@model IEnumerable<VanPhongPhamOnline.ViewModels.CartItem>
@{
    ViewData["Title"] = "Thanh toán";
    var subtotal = Model.Sum(p => p.ThanhTien);
    var shipping = 10000;
    var total = subtotal + shipping;
}

<div class="container py-5">
    <h1 class="mb-4">Thông tin thanh toán</h1>

    <form id="checkoutForm" asp-action="Checkout" asp-controller="Cart" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        @if (!string.IsNullOrEmpty(ViewBag.MaVoucherApplied))
        {
            <input type="hidden" name="MaVoucher" value="@ViewBag.MaVoucherApplied" />
        }
        <div class="row g-5">
            <!-- Thông tin giao hàng -->
            <div class="col-lg-7">
                <div class="form-check mb-3">
                    <input type="checkbox" name="GiongKhachHang" class="form-check-input" id="GiongKhachHang" value="true">
                    <label class="form-check-label" for="GiongKhachHang">Giống thông tin khách hàng?</label>
                </div>

                <div class="delivery-info">
                    <div class="mb-3">
                        <label class="form-label">Người nhận hàng <sup>*</sup></label>
                        <input type="text" name="HoTen" class="form-control" maxlength="50">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ nhận hàng <sup>*</sup></label>
                        <input type="text" name="DiaChi" class="form-control" placeholder="123 Lê Lợi" maxlength="60">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Điện thoại <sup>*</sup></label>
                        <input type="text" name="DienThoai" class="form-control" maxlength="24">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ghi chú</label>
                    <textarea name="GhiChu" class="form-control" rows="5" placeholder="Ghi chú..." maxlength="50"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Mã giảm giá (nếu có)</label>
                    <div class="input-group">
                        <input type="text" name="MaVoucher" class="form-control" placeholder="Nhập mã giảm giá..." maxlength="20">
                        <button class="btn btn-outline-secondary" type="button">Áp dụng</button>
                    </div>
                    <small class="text-muted">Nhập mã giảm giá để nhận ưu đãi khi thanh toán.</small>
                </div>
            </div>

            <!-- Tóm tắt đơn hàng -->
            <div class="col-lg-5">
                <div class="table-responsive mb-4">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ảnh</th>
                                <th>Tên Sản Phẩm</th>
                                <th>Giá</th>
                                <th>SL</th>
                                <th>Tổng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@Url.Content("~/Hinh/HangHoa/" + item.Hinh)"
                                             class="img-fluid rounded" style="width:60px;height:60px;" alt="@item.TenHH">
                                    </td>
                                    <td>@item.TenHH</td>
                                    <td>@item.DonGia.ToString("N0")</td>
                                    <td>@item.SoLuong</td>
                                    <td>@item.ThanhTien.ToString("N0")</td>
                                </tr>
                            }
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Thành tiền</td>
                                <td>@subtotal.ToString("N0") VNĐ</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Tiền ship</td>
                                <td>@shipping.ToString("N0") VNĐ</td>
                            </tr>
                            @if (!string.IsNullOrEmpty(ViewBag.MaVoucherApplied) && ViewBag.GiamGiaVoucherApplied > 0)
                            {
                                <tr class="text-success">
                                    <td colspan="4" class="text-end fw-bold">Giảm giá (voucher):</td>
                                    <td class="fw-bold">-@ViewBag.GiamGiaVoucherApplied.ToString("N0") VNĐ</td>
                                </tr>
                            }
                            <tr class="table-light">
                                <td colspan="4" class="text-end fw-bold text-uppercase">Tổng tiền</td>
                                <td class="fw-bold text-danger">@((subtotal - (ViewBag.GiamGiaVoucherApplied ?? 0) + shipping).ToString("N0")) VNĐ</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Phương thức thanh toán -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Phương thức thanh toán</label>
                    <div class="form-check">
                        <input type="radio" class="form-check-input payment-method" name="PaymentMethod" value="BANK" id="payBank" checked>
                        <label class="form-check-label" for="payBank">Chuyển khoản ngân hàng</label>
                    </div>
                    <div class="form-check">
                        <input type="radio" class="form-check-input payment-method" name="PaymentMethod" value="COD" id="payCod">
                        <label class="form-check-label" for="payCod">Thanh toán khi nhận hàng (COD)</label>
                    </div>
                    <div class="form-check">
                        <input type="radio" class="form-check-input payment-method" name="PaymentMethod" value="PAYPAL" id="payPal">
                        <label class="form-check-label" for="payPal">PayPal</label>
                    </div>
                </div>

                <!-- Thông tin tài khoản ngân hàng (hiện khi chọn Chuyển khoản) -->
                <div id="bankInfo" class="mb-3 p-3 bg-light rounded border">
                    <h6 class="fw-bold">Thông tin tài khoản ngân hàng</h6>
                    <p class="mb-1"><strong>Ngân hàng:</strong> Vietcombank (VCB)</p>
                    <p class="mb-1"><strong>Chủ tài khoản:</strong> CÔNG TY VĂN PHÒNG PHẨM ONLINE</p>
                    <p class="mb-1"><strong>Số tài khoản:</strong> 1234567890</p>
                    <p class="mb-0 text-muted">Sau khi chuyển khoản, đơn hàng sẽ ở trạng thái "Chưa xác nhận" chờ admin duyệt.</p>
                </div>

                <!-- Nút đặt hàng -->
                <button type="submit" class="btn btn-primary w-100 mb-3">Đặt hàng</button>

                <!-- PayPal button -->
                <div id="paypal-button-container"></div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.PaypalClientId"></script>
    <script>
        $(function () {
            $("#GiongKhachHang").change(function () {
                $(".delivery-info").toggleClass("d-none", $(this).is(":checked"));
            });

            // Toggle hiển thị thông tin ngân hàng khi chọn phương thức thanh toán
            function toggleBankInfo() {
                const selected = $("input[name='PaymentMethod']:checked").val();
                $("#bankInfo").toggle(selected === "BANK");
            }
            $("input[name='PaymentMethod']").change(toggleBankInfo);
            toggleBankInfo();

            paypal.Buttons({
                style: { color: 'silver', layout: 'vertical' },
                createOrder: () => {
                    return fetch("/Cart/create-paypal-order", { method: "post" })
                        .then(res => res.ok ? res.json() : res.json().then(err => { throw err; }))
                        .then(order => order.id)
                        .catch(err => alert(err.message));
                },
                onApprove: (data) => {
                    // Gửi kèm thông tin người nhận trên form để lưu vào hóa đơn
                    const checkoutForm = document.getElementById("checkoutForm");
                    return fetch(`/Cart/capture-paypal-order?orderId=${data.orderID}`, { method: "post", body: new FormData(checkoutForm) })
                        .then(res => res.ok ? res.json() : res.json().then(err => { throw err; }))
                        .then(() => window.location.href = "/Cart/Success")
                        .catch(err => alert(err.message));
                }
            }).render('#paypal-button-container');
        });
    </script>
}
